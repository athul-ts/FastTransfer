{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum permissions for the FastTransfer window. See SRS §81 — the webview gets no unrestricted filesystem access; all file I/O happens in the Rust core, which the frontend reaches only through the commands in commands.rs.",

  "windows": ["main"],

  "permissions": [
    "core:default",

    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",

    "notification:default",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-arch",

    "fs:allow-read-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/FastTransfer" },
        { "path": "$DOWNLOAD/FastTransfer/**" },
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPLOCALDATA" },
        { "path": "$APPLOCALDATA/**" }
      ]
    }
  ]
}
