# FastTransfer — environment template
#
# Copy to `.env` for local development. `.env` is gitignored.
# Never commit real values. See CLAUDE.md § Security rules.

# ---------------------------------------------------------------------------
# Frontend (must be prefixed VITE_ to reach the browser bundle)
# ---------------------------------------------------------------------------

# Log verbosity surfaced in the UI: error | warn | info | debug | trace
VITE_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Rust core (read via std::env; NOT prefixed so they stay out of the bundle)
# ---------------------------------------------------------------------------

# Log filter for tracing-subscriber, e.g. "fasttransfer=debug,info"
FASTTRANSFER_LOG=info

# UDP/TCP port the core listens on for direct-link discovery and transfer.
# Both peers must agree. Overridable in Settings > Network.
FASTTRANSFER_PORT=47820

# Force a discovery mode for testing: mdns | linklocal | auto
FASTTRANSFER_DISCOVERY=auto

# Development only: skip OS keychain and use an in-memory identity store.
# NEVER set this in a production build.
FASTTRANSFER_INSECURE_IDENTITY_STORE=0

# ---------------------------------------------------------------------------
# Release signing (CI only — never set these locally)
# ---------------------------------------------------------------------------

# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_SIGNING_IDENTITY=
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=
